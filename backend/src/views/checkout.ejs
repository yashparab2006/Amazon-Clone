<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Checkout' }) %>
</head>
<body>

    <%- include('partials/navbar') %>

    <main class="page-main checkout-page">
        <h1 class="page-title">Checkout</h1>

        <div class="checkout-layout" id="checkoutContent">
            <form class="checkout-form" id="checkoutForm" action="/checkout/place-order" method="POST">
                <section class="checkout-section">
                    <h2>1. Delivery Address</h2>
                    <label>Full Name
                        <input type="text" id="fullName" name="fullName" required
                               value="<%= user ? user.name : '' %>">
                    </label>
                    <label>Phone
                        <input type="tel" id="phone" name="phone" required pattern="[0-9]{10}"
                               placeholder="10-digit mobile">
                    </label>
                    <label>Address
                        <textarea id="address" name="address" required rows="3"></textarea>
                    </label>
                    <label>City
                        <input type="text" id="city" name="city" required>
                    </label>
                    <label>Pincode
                        <input type="text" id="pincode" name="pincode" required pattern="[0-9]{6}"
                               placeholder="6-digit pincode">
                    </label>
                </section>

                <section class="checkout-section">
                    <h2>2. Payment Method</h2>
                    <label class="radio-label"><input type="radio" name="payment" value="cod" checked> Cash on Delivery</label>
                    <label class="radio-label"><input type="radio" name="payment" value="card"> Credit / Debit Card</label>
                    <label class="radio-label"><input type="radio" name="payment" value="upi"> UPI</label>
                </section>

                <!-- Cart summary injected by JS -->
                <input type="hidden" name="cartData" id="cartData" value="">

                <button type="submit" class="btn-place-order">Place your order</button>
            </form>

            <aside class="checkout-summary">
                <h2>Order Summary</h2>
                <div id="orderItems"><!-- Filled by checkout.js --></div>
                <hr>
                <p class="order-total">Order Total: <strong id="orderTotal">₹0</strong></p>
            </aside>
        </div>

        <% if (locals.orderSuccess) { %>
        <div class="order-success" id="orderSuccess" style="display:block;">
            <i class="fa-solid fa-circle-check"></i>
            <h2>Order Placed Successfully!</h2>
            <p>Thank you for shopping with Amazon. Your order ID is <strong><%= orderId %></strong></p>
            <a href="/" class="btn-primary">Continue Shopping</a>
        </div>
        <% } else { %>
        <div class="order-success" id="orderSuccess" style="display:none;"></div>
        <% } %>
    </main>

    <%- include('partials/footer') %>

    <div class="toast" id="toast"></div>

    <script src="/js/common.js"></script>
    <script src="/js/checkout.js"></script>
</body>
</html>

