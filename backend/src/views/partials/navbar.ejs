<header>
    <div class="navbar">
        <div class="nav-logo border" id="logoBtn" title="Amazon Home">
            <div class="logo"></div>
        </div>
        <div class="nav-address border" id="locationBtn">
            <p class="add-first">Deliver to</p>
            <div class="add-icon">
                <i class="fa-solid fa-location-dot"></i>
                <p class="add-sec">India</p>
            </div>
        </div>
        <div class="nav-search" id="searchBar">
            <select class="search-select" id="searchCategory">
                <% categories.forEach(function(cat) { %>
                    <option value="<%= cat %>" <%= (selectedCategory === cat) ? 'selected' : '' %>>
                        <%= cat === 'All' ? 'All' : cat.split(' ')[0] %>
                    </option>
                <% }); %>
            </select>
            <form action="/" method="GET" style="display:contents;">
                <input type="hidden" name="category" id="searchCategoryHidden" value="<%= selectedCategory %>">
                <input type="text" name="search" placeholder="Search Amazon" class="search-input" id="searchInput"
                       value="<%= searchQuery %>" autocomplete="off">
                <button type="submit" class="search-icon" id="searchBtn" aria-label="Search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>
        <div class="nav-signin border" id="signinBtn">
            <p><span><%= user ? 'Hello, ' + user.name : 'Hello, sign in' %></span></p>
            <p class="nav-second">Account &amp; Lists</p>
            <i class="fa-solid fa-caret-down" style="font-size: 0.5rem; margin-left: 4px;"></i>
        </div>
        <div class="nav-return border" id="ordersBtn">
            <p><span>Returns</span></p>
            <p class="nav-second">&amp; Orders</p>
        </div>
        <a href="/cart" class="nav-cart border" id="cartBtn" style="text-decoration:none; color:inherit;">
            <div class="cart-icon-wrap">
                <i class="fa-solid fa-cart-shopping"></i>
                <span class="cart-count" id="cartCount">0</span>
            </div>
            <span class="cart-label">Cart</span>
        </a>
    </div>
    <div class="panel">
        <div class="panel-all border" id="panelAll">
            <i class="fa-solid fa-bars"></i> All
        </div>
        <div class="panel-ops">
            <a href="/?filter=deals" class="panel-link">Today's Deals</a>
            <a href="/customer-service" class="panel-link">Customer Service</a>
            <a href="/registry" class="panel-link">Registry</a>
            <a href="/gift-cards" class="panel-link">Gift Cards</a>
            <a href="/sell" class="panel-link">Sell</a>
        </div>
        <a href="/?category=Electronics" class="panel-deals panel-link">Shop deals in Electronics</a>
    </div>
</header>

